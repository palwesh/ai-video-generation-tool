# Optional. If missing, the batch runner uses a local fallback generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TRF_AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional natural voice generation.
TRF_TTS_PROVIDER=local
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=verse
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional automated avatar clips from your own/consented image.
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=

# Optional. Use a logged-in Chrome profile for Google Vids/manual capture workflows.
PLAYWRIGHT_CHANNEL=chrome

# Optional. Used by scripts/download-google-vid.mjs.
GOOGLE_ACCESS_TOKEN=
GOOGLE_VIDS_FILE_ID=
