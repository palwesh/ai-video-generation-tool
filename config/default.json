{
  "language": "Hinglish",
  "durationSeconds": 60,
  "sceneCount": 6,
  "sceneDurationSeconds": 10,
  "style": "realistic, modern, professional SaaS/UGC",
  "aiModel": "gpt-5-mini",
  "ai": {
    "enabled": false,
    "provider": "openai",
    "openaiModel": "gpt-5-mini",
    "geminiModel": "gemini-2.5-pro"
  },
  "voiceover": {
    "provider": "local",
    "openaiModel": "gpt-4o-mini-tts",
    "openaiVoice": "verse",
    "elevenLabsModel": "eleven_multilingual_v2",
    "note": "Use local for built-in macOS/Windows TTS. Use openai or elevenlabs when API keys are configured."
  },
  "avatarGeneration": {
    "provider": "manual",
    "providers": "heygen,did,runway,veo,pika",
    "referenceImages": "",
    "scenes": "1,2,6",
    "heygenVoiceId": "",
    "note": "Use manual to prepare prompts. Use heygen only when HEYGEN_API_KEY and HEYGEN_VOICE_ID are configured."
  },
  "toolBaseUrl": "https://www.altftool.com/",
  "capture": {
    "enabled": false,
    "timeoutMs": 45000,
    "desktopViewport": {
      "width": 1365,
      "height": 768
    },
    "mobileViewport": {
      "width": 390,
      "height": 844
    },
    "scrollSteps": 4,
    "recordWebm": true
  },
  "googleVids": {
    "defaultAvatar": "auto",
    "defaultAvatarScenes": "1,2,6",
    "defaultIngredientScenes": "3,4,5",
    "avatarOptions": [
      { "label": "Personal Avatar - Me", "value": "Me" },
      { "label": "Auto Realistic", "value": "auto" },
      { "label": "Mia - Realistic", "value": "Mia" },
      { "label": "Finley - Realistic", "value": "Finley" },
      { "label": "Sebastian - Realistic", "value": "Sebastian" },
      { "label": "Levi - Realistic", "value": "Levi" },
      { "label": "Sofia - Realistic", "value": "Sofia" },
      { "label": "Jamal - Realistic", "value": "Jamal" },
      { "label": "William - Realistic", "value": "William" },
      { "label": "Eleanor - Realistic", "value": "Eleanor" }
    ]
  },
  "freeVideoProviders": {
    "defaultProviders": "capcut,pika,runway,canva,did,shotstack",
    "note": "Creates prompt folders for free/free-trial video tools. Downloaded clips can be copied into vids-clips/scene-XX.mp4 for local merge."
  },
  "driveSync": {
    "enabled": false,
    "rootDir": ""
  },
  "output": {
    "rootDir": "outputs/runs"
  }
}
